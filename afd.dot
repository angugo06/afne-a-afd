digraph AFD {
  rankdir=LR;
  node [shape=circle, fontname="Arial"];
  edge [fontname="Arial"];
  inicio [shape=point, label=""];
  "S0" [shape=doublecircle, label="S0\n{q0,q1,q2}"];
  "S1" [shape=doublecircle, label="S1\n{q1,q2}"];
  "S2" [shape=doublecircle, label="S2\n{q2}"];
  "∅" [shape=circle, label="∅"];
  inicio -> "S0";
  "S0" -> "S0" [label="a"];
  "S0" -> "S1" [label="b"];
  "S0" -> "S2" [label="c"];
  "S1" -> "∅" [label="a"];
  "S1" -> "S1" [label="b"];
  "S1" -> "S2" [label="c"];
  "S2" -> "∅" [label="a,b"];
  "S2" -> "S2" [label="c"];
  "∅" -> "∅" [label="a,b,c"];
}
